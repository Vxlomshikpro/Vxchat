    "modmenu": ["ru.vxlomshikpro.vxchat.VxChatModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}